<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 128色流彩漸層邊框 (Rainbow Gradient Stroke) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#FF007F"
                android:centerColor="#00FFC2"
                android:endColor="#7F00FF"
                android:type="linear"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <!-- 內層完全透明填充 (Transparent Fill - 移除實心卡片背景) -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
</layer-list>
