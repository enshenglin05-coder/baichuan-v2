<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPasswordLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btnPasswordBack"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_capsule_button"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="← 返回首頁"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="安全驗證"
            android:textColor="#00FFC2"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="後端管理人員專用"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingBottom="36dp" />

            <!-- 上方安全密碼輸入區段 -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=""
                app:boxBackgroundColor="#1A1A1A"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#00FFC2"
                app:hintTextColor="#00FFC2"
                android:textColorHint="#888888"
                android:layout_marginBottom="20dp"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#00FFC2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTop10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword|textCapCharacters"
                    android:maxLength="10"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 下方安全密碼輸入區段 -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint=""
                app:boxBackgroundColor="#1A1A1A"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="#00FFC2"
                app:hintTextColor="#00FFC2"
                android:textColorHint="#888888"
                android:layout_marginBottom="24dp"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#00FFC2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBottom10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword|textCapCharacters"
                    android:maxLength="10"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Hint / Status -->
            <TextView
                android:id="@+id/tvPasswordHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FF4444"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingBottom="24dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerifyAndEnterUI5"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="驗證並解鎖進入 UI 5 核心配置"
        android:backgroundTint="#00FFC2"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="28dp" />

</LinearLayout>
