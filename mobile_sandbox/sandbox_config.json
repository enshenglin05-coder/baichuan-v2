package com.baichuan.mobile_sandbox

import android.util.Log
import org.json.JSONObject
import java.net.URL

object MobileSandboxLoader {
    private const val TAG = "SANDBOX_SOURCE"
    private const val GITHUB_CONFIG_URL = "https://raw.githubusercontent.com/enshenglin05-coder/baichuan-v2/main/mobile_sandbox/sandbox_config.json"

    data class SandboxConfig(
        val latitude: Double,
        val longitude: Double,
        val distanceRangeKm: Double,
        val countdownSeconds: Int,
        val ttsBroadcastText: String
    )

    fun fetchAndParseConfig(): SandboxConfig? {
        return try {
            val jsonString = URL(GITHUB_CONFIG_URL).readText()
            val json = JSONObject(jsonString)
            val params = json.getJSONObject("parameters")

            val config = SandboxConfig(
                latitude = params.getDouble("latitude"),
                longitude = params.getDouble("longitude"),
                distanceRangeKm = params.getDouble("distance_range_km"),
                countdownSeconds = params.getInt("countdown_seconds"),
                ttsBroadcastText = params.getString("tts_broadcast_text")
            )
            
            Log.d(TAG, "🔥 [沙盒熱更新] 成功載入遠端參數，播報文字: ${config.ttsBroadcastText}")
            config
        } catch (e: Exception) {
            Log.w(TAG, "⚠️ [本地預設] 無法讀取遠端沙盒或格式錯誤，走本地備援邏輯: ${e.message}")
            null
        }
    }
}
